{
  "schemaVersion": 2,
  "id": "mail-browser-proof",
  "displayName": "Arcane Mail Browser Proof",
  "description": "Disposable SDK Mail and DBOPFS browser acceptance fixture.",
  "version": "0.1.0",
  "publisher": {
    "id": "the-wizard-nexus",
    "name": "The Wizard Nexus"
  },
  "package": {
    "entry": "index.html",
    "strategy": "static",
    "include": ["mail-browser-proof.css", "index.html", "manifest.json", "modules"],
    "exclude": [],
    "shared": ["browser-runtime"]
  },
  "permissions": {
    "capabilities": [],
    "methods": []
  },
  "security": {
    "connectOrigins": ["http://127.0.0.1:8025"],
    "frameOrigins": [],
    "mediaOrigins": []
  },
  "native": {
    "type": "app",
    "icon": null,
    "order": 100,
    "bundledApps": []
  },
  "requirements": {
    "arcaneProtocol": "arcane/1",
    "minimumCoreVersion": "0.8.12",
    "features": []
  },
  "targets": ["browser"]
}
