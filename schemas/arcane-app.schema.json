{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheWizardNexus/arcane-os-sdk/schemas/arcane-app.schema.json",
  "title": "Arcane application descriptor",
  "description": "Canonical application-owned descriptor projected into browser packaging and native Arcane admission inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "version",
    "publisher",
    "package",
    "native",
    "requirements",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/appId" },
    "displayName": { "$ref": "#/$defs/presentationText" },
    "description": { "$ref": "#/$defs/description" },
    "version": { "$ref": "#/$defs/semver" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "$ref": "#/$defs/presentationText" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "strategy", "include", "exclude", "shared"],
      "properties": {
        "entry": { "$ref": "#/$defs/relativePath" },
        "strategy": { "enum": ["static", "adapter"] },
        "localAIModelPolicy": { "$ref": "#/$defs/localAIModelPolicy" },
        "include": { "$ref": "#/$defs/nonemptyPathList" },
        "exclude": { "$ref": "#/$defs/pathList" },
        "shared": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
        },
        "adapter": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "pattern": "^scripts/[A-Za-z0-9._/-]+\\.mjs$" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "adapter" } }, "required": ["strategy"] },
          "then": { "required": ["adapter"] },
          "else": { "not": { "required": ["adapter"] } }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "allOf": [
            { "$ref": "#/$defs/permissionList" },
            {
              "not": {
                "allOf": [
                  { "contains": { "const": "external.open" } },
                  { "contains": { "const": "web.embed" } }
                ]
              }
            }
          ]
        },
        "methods": { "$ref": "#/$defs/methodList" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectOrigins": { "$ref": "#/$defs/connectOriginList" },
        "frameOrigins": { "$ref": "#/$defs/frameOriginList" },
        "mediaOrigins": { "$ref": "#/$defs/httpsOriginList" }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "icon", "order", "bundledApps"],
      "properties": {
        "type": { "const": "app" },
        "icon": {
          "description": "A safe raster image path. Native targets require a non-null value. Coverage by package.include is enforced by the runtime validator because JSON Schema cannot compare property values or path prefixes.",
          "oneOf": [{ "$ref": "#/$defs/rasterIcon" }, { "type": "null" }]
        },
        "order": { "type": "integer", "minimum": 0 },
        "bundledApps": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/appId" }
        },
        "documentCatalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": { "enum": ["empty-unpublished", "public-only"] },
            "release": { "$ref": "#/$defs/relativePath" },
            "destination": { "$ref": "#/$defs/relativePath" },
            "originals": { "$ref": "#/$defs/relativePath" },
            "manifest": { "type": "string", "pattern": "^[^/\\\\]+\\.json$" },
            "expectedCount": { "type": "integer", "minimum": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "policy": { "const": "empty-unpublished" } }, "required": ["policy"] },
              "then": {
                "required": ["policy", "destination", "manifest"],
                "not": { "anyOf": [{ "required": ["release"] }, { "required": ["originals"] }, { "required": ["expectedCount"] }] }
              },
              "else": { "required": ["policy", "release", "destination", "originals", "manifest", "expectedCount"] }
            }
          ]
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arcaneProtocol", "features"],
      "properties": {
        "arcaneProtocol": { "const": "arcane/1" },
        "minimumCoreVersion": { "$ref": "#/$defs/semver" },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["android-arm64", "browser", "linux-arm64", "linux-x64", "portable", "windows-x64"]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "targets": { "contains": { "not": { "const": "browser" } } }
        },
        "required": ["targets"]
      },
      "then": {
        "properties": {
          "native": {
            "properties": {
              "icon": { "$ref": "#/$defs/rasterIcon" }
            },
            "required": ["icon"]
          },
          "requirements": {
            "required": ["minimumCoreVersion"]
          }
        },
        "required": ["native", "requirements"]
      }
    },
    {
      "if": {
        "properties": {
          "security": {
            "properties": {
              "frameOrigins": { "minItems": 1 }
            },
            "required": ["frameOrigins"]
          }
        },
        "required": ["security"]
      },
      "then": {
        "properties": {
          "permissions": {
            "properties": {
              "capabilities": { "contains": { "const": "web.embed" } }
            },
            "required": ["capabilities"]
          }
        },
        "required": ["permissions"]
      }
    },
    {
      "if": {
        "properties": {
          "id": { "not": { "const": "browser" } }
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "security": {
            "properties": {
              "frameOrigins": {
                "not": { "contains": { "const": "https:" } }
              }
            },
            "required": ["frameOrigins"]
          }
        }
      }
    }
  ],
  "$defs": {
    "appId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "presentationText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^<>\\u0000-\\u001f\\u007f]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^<>\\u0000-\\u001f\\u007f]+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\\\)(?!.*:)(?!.*[<>\"|?*])(?!.*(?:^|/)(?:\\.{1,2}|(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?)(?:/|$))(?!.*[. ](?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/[^/\\u0000-\\u001f\\u007f]+)*$"
    },
    "rasterIcon": {
      "allOf": [
        { "$ref": "#/$defs/relativePath" },
        {
          "pattern": "\\.(?:[Ii][Cc][Oo]|[Jj][Pp][Ee]?[Gg]|[Pp][Nn][Gg]|[Ww][Ee][Bb][Pp])$"
        }
      ]
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "nonemptyPathList": {
      "allOf": [{ "$ref": "#/$defs/pathList" }, { "minItems": 1 }]
    },
    "permissionList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" }
    },
    "methodList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)+$" }
    },
    "connectOriginList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:https://[^/?#]+|http://(?:127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?)$"
      }
    },
    "httpsOriginList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://[^/?#]+$" }
    },
    "frameOriginList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:https:|https://[^/?#]+)$" }
    },
    "localAIModelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_only", "models"],
      "properties": {
        "verified_only": { "type": "boolean" },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "definition"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "definition": { "$ref": "#/$defs/relativePath" }
            }
          }
        }
      }
    }
  }
}
