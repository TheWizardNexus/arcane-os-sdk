{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheWizardNexus/arcane-os-sdk/schemas/arcane-package.schema.json",
  "title": "Arcane application package",
  "description": "Authored application input accepted by the Arcane application packager.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "version",
    "entry",
    "strategy",
    "include",
    "shared"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/appId"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^<>\\u0000-\\u001f\\u007f]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "entry": {
      "$ref": "#/$defs/relativePath"
    },
    "documents": {
      "type": "array",
      "description": "Application-relative HTML/HTM pages managed by import-map and PWA processing. Entry is always first; an empty list selects entry only. Omission preserves automatic discovery. File inclusion and serving remain controlled by include/exclude.",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/relativePath" },
          { "pattern": "\\.[Hh][Tt][Mm][Ll]?$" }
        ]
      }
    },
    "outputDirectory": {
      "$ref": "#/$defs/relativePath",
      "description": "Final package directory relative to the workspace, with no appended app ID. Omission preserves dist/<id>. This directory is replaced when packaging succeeds; source layout and app identity remain unchanged."
    },
    "strategy": {
      "enum": [
        "static",
        "adapter"
      ]
    },
    "localAIModelPolicy": {
      "$ref": "#/$defs/localAIModelPolicy"
    },
    "localAI": {
      "$ref": "#/$defs/localAI"
    },
    "pwa": {
      "$ref": "#/$defs/pwa"
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectOrigins": {
          "$ref": "#/$defs/connectOriginList"
        },
        "frameOrigins": {
          "$ref": "#/$defs/frameOriginList"
        },
        "mediaOrigins": {
          "$ref": "#/$defs/httpsOriginList"
        }
      }
    },
    "include": {
      "allOf": [
        {
          "$ref": "#/$defs/pathList"
        },
        {
          "minItems": 1
        }
      ]
    },
    "exclude": {
      "$ref": "#/$defs/pathList"
    },
    "nativeResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "description": "Additional literal application-relative paths for a selected nonbrowser target. Exclude applies only to this additional selection. Native-only files retain their complete original content and do not enter browser document or PWA processing. Omission or an empty include preserves existing selection and output behavior.",
      "properties": {
        "include": { "$ref": "#/$defs/pathList" },
        "exclude": { "$ref": "#/$defs/pathList" }
      }
    },
    "shared": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "adapter": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "^scripts/[A-Za-z0-9._/-]+\\.mjs$"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "strategy": {
            "const": "adapter"
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "required": [
          "adapter"
        ]
      },
      "else": {
        "not": {
          "required": [
            "adapter"
          ]
        }
      }
    }
  ],
  "$defs": {
    "localAI": {
      "type": "object",
      "required": ["runtimes"],
      "description": "Required Core AI runtimes. Development ensures selected runtimes locally; native builds bundle their upstream runtime distributions. Model selection remains application-owned.",
      "properties": {
        "runtimes": {
          "type": "array",
          "items": {
            "oneOf": [
              { "enum": ["llama.cpp", "ollama", "onnx", "stable-diffusion.cpp", "whisper.cpp", "kokoro-native"] },
              {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "enum": ["llama.cpp", "ollama", "onnx", "stable-diffusion.cpp", "kokoro-native"] },
                  "version": { "type": "string" },
                  "url": { "type": "string" },
                  "backend": { "type": "string", "description": "llama.cpp: auto, cpu or cuda. Image runtimes: auto, metal or cpu." },
                  "companionUrl": { "type": "string", "description": "Explicit CUDA runtime companion archive for a custom llama.cpp CUDA URL." }
                }
              },
              { "$ref": "#/$defs/whisperRuntime" }
            ]
          }
        },
        "llamaCpp": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "model": { "type": "string" },
            "alias": { "type": "string" },
            "executionTarget": {
              "oneOf": [
                { "type": "null" },
                { "type": "object", "required": ["deviceId"], "properties": { "deviceId": { "type": "string" } } }
              ]
            },
            "modelsDirectory": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        },
        "ollama": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "modelsDirectory": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "whisperRuntime": {
      "type": "object",
      "required": ["id"],
      "description": "Native Whisper transcription. Models are explicitly selected; describing a runtime acquires nothing. Automatic Windows x64 preparation selects intact CUDA and CPU distributions, an SDK helper, and FFmpeg. Other hosts supply their selected complete runtime and decoder trees.",
      "properties": {
        "id": { "const": "whisper.cpp" },
        "version": { "type": "string", "default": "1.9.4" },
        "backend": { "enum": ["auto", "cuda", "metal", "cpu"], "default": "auto" },
        "encoder": { "const": "openvino-npu", "description": "Explicit Intel NPU encoder. Omit for ordinary GPU/CPU encoding. The precompiled Windows x64 runtime supports CUDA-first CPU recovery and requires a compatible installed Intel NPU driver." },
        "helperRoot": { "type": "string", "description": "Complete helper directory copied into the native runtime, including its app-local libraries. Defaults to the directory containing helperExecutable." },
        "helperExecutable": { "type": "string" },
        "helperUrl": { "type": "string" },
        "helperVersion": { "type": "string" },
        "decoderRoot": { "type": "string" },
        "decoderExecutable": { "type": "string" },
        "decoderUrl": { "type": "string" },
        "modelId": { "type": "string" },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["backend"],
            "properties": {
              "backend": { "enum": ["cuda", "metal", "cpu"] },
              "encoder": { "const": "openvino-npu" },
              "root": { "type": "string" },
              "url": { "type": "string" },
              "libraryDirectory": { "type": "string" }
            }
          }
        },
        "models": {
          "type": "array",
          "default": [],
          "items": {
            "oneOf": [
              { "const": "whisper-small" },
              {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string" },
                  "path": { "type": "string" },
                  "url": { "type": "string" },
                  "filename": { "type": "string" },
                  "archiveUrl": { "type": "string", "description": "Complete model archive containing the declared model members." },
                  "encoderFilename": { "type": "string", "description": "Matching OpenVINO encoder XML filename in archiveUrl." },
                  "encoderDataFilename": { "type": "string", "description": "Matching OpenVINO encoder BIN filename in archiveUrl." },
                  "encoderPath": { "type": "string", "description": "Matching local OpenVINO encoder XML file." },
                  "encoderDataPath": { "type": "string", "description": "Matching local OpenVINO encoder BIN file." }
                }
              }
            ]
          }
        }
      }
    },
    "pwa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "manifest": {
          "type": "object",
          "description": "Application-owned Web App Manifest members, including branding, icons, and presentation."
        },
        "offline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": {
              "type": "array",
              "description": "Literal package paths or directories to cache. Omitted or empty selects all emitted files.",
              "items": { "type": "string", "minLength": 1 }
            },
            "exclude": {
              "type": "array",
              "description": "Literal package paths or directories excluded from offline assets. Generated shell records and the entry remain available.",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\\\)(?!.*:)(?!.*[<>\"|?*])(?!.*(?:^|/)(?:\\.{1,2}|(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?)(?:/|$))(?!.*[. ](?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/[^/\\u0000-\\u001f\\u007f]+)*$"
    },
    "literalRelativePath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "^[^*?\\[\\]{}]+$"
        }
      ]
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/literalRelativePath"
      }
    },
    "connectOriginList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:https://[^/?#]+|http://(?:127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?)$"
      }
    },
    "httpsOriginList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^/?#]+$"
      }
    },
    "frameOriginList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:https:|https://[^/?#]+)$"
      }
    },
    "localAIModelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_only",
        "models"
      ],
      "properties": {
        "verified_only": {
          "type": "boolean"
        },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "definition"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(?::[A-Za-z0-9][A-Za-z0-9._-]*)?$",
                "not": {
                  "pattern": "^[Oo][Pp][Ee][Nn][Aa][Ii]$"
                }
              },
              "definition": {
                "type": "string",
                "pattern": "^(?:Modelfile|[A-Za-z0-9][A-Za-z0-9._-]*\\.Modelfile)$"
              }
            }
          }
        }
      }
    }
  }
}
