{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheWizardNexus/arcane-os-sdk/schemas/arcane-package.schema.json",
  "title": "Arcane application package",
  "description": "Authored application input accepted by the Arcane application packager.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "version",
    "entry",
    "strategy",
    "include",
    "shared"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/appId"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^<>\\u0000-\\u001f\\u007f]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "entry": {
      "$ref": "#/$defs/relativePath"
    },
    "strategy": {
      "enum": [
        "static",
        "adapter"
      ]
    },
    "localAIModelPolicy": {
      "$ref": "#/$defs/localAIModelPolicy"
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectOrigins": {
          "$ref": "#/$defs/connectOriginList"
        },
        "frameOrigins": {
          "$ref": "#/$defs/frameOriginList"
        },
        "mediaOrigins": {
          "$ref": "#/$defs/httpsOriginList"
        }
      }
    },
    "include": {
      "allOf": [
        {
          "$ref": "#/$defs/pathList"
        },
        {
          "minItems": 1
        }
      ]
    },
    "exclude": {
      "$ref": "#/$defs/pathList"
    },
    "shared": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "adapter": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "^scripts/[A-Za-z0-9._/-]+\\.mjs$"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "strategy": {
            "const": "adapter"
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "required": [
          "adapter"
        ]
      },
      "else": {
        "not": {
          "required": [
            "adapter"
          ]
        }
      }
    }
  ],
  "$defs": {
    "appId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\\\)(?!.*:)(?!.*[<>\"|?*])(?!.*(?:^|/)(?:\\.{1,2}|(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.[^/]*)?)(?:/|$))(?!.*[. ](?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/[^/\\u0000-\\u001f\\u007f]+)*$"
    },
    "literalRelativePath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "^[^*?\\[\\]{}]+$"
        }
      ]
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/literalRelativePath"
      }
    },
    "connectOriginList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:https://[^/?#]+|http://(?:127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?)$"
      }
    },
    "httpsOriginList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^/?#]+$"
      }
    },
    "frameOriginList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:https:|https://[^/?#]+)$"
      }
    },
    "localAIModelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_only",
        "models"
      ],
      "properties": {
        "verified_only": {
          "type": "boolean"
        },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "definition"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(?::[A-Za-z0-9][A-Za-z0-9._-]*)?$",
                "not": {
                  "pattern": "^[Oo][Pp][Ee][Nn][Aa][Ii]$"
                }
              },
              "definition": {
                "type": "string",
                "pattern": "^(?:Modelfile|[A-Za-z0-9][A-Za-z0-9._-]*\\.Modelfile)$"
              }
            }
          }
        }
      }
    }
  }
}
