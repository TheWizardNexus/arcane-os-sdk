{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheWizardNexus/arcane-os-sdk/schemas/target-adapter.schema.json",
  "title": "Arcane target adapter descriptor",
  "description": "Stable, serializable description of a build and run target adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "displayName",
    "status",
    "platforms",
    "architectures",
    "formats",
    "signingModes",
    "reason",
    "methods"
  ],
  "properties": {
    "protocol": {
      "const": "arcane-target-adapter/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "available",
        "pairing-required",
        "host-unsupported",
        "deferred",
        "incompatible"
      ]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "any",
          "windows",
          "linux",
          "android"
        ]
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "any",
          "x64",
          "arm64"
        ]
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "directory",
          "portable",
          "exe",
          "appimage",
          "deb",
          "rpm",
          "apk",
          "aab"
        ]
      }
    },
    "signingModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "development",
          "production"
        ]
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048
    },
    "methods": {
      "const": [
        "describe",
        "doctor",
        "plan",
        "build",
        "verify",
        "run"
      ]
    }
  }
}
