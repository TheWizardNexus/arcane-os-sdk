{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheWizardNexus/arcane-os-sdk/schemas/native-build-plan.schema.json",
  "title": "Arcane native build plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "generation", "toolchain", "minimumCoreVersion", "app", "dependencies", "targetRequest", "outputRoot", "operations"],
  "properties": {
    "protocol": { "const": "arcane-native-build-plan/1" },
    "generation": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "providerGeneration": { "$ref": "#/$defs/providerGeneration" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "minimumCoreVersion": { "$ref": "#/$defs/semver" },
    "app": { "$ref": "#/$defs/app" },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/app" }
    },
    "targetRequest": { "$ref": "#/$defs/targetRequest" },
    "outputRoot": { "type": "string", "minLength": 1 },
    "operations": {
      "const": [
        "authenticate-toolchain",
        "authenticate-app-release",
        "authenticate-dependency-releases",
        "build-selected-target",
        "verify-native-artifact"
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "providerGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "generationSha256", "contentSha256", "moduleCount"],
      "properties": {
        "kind": { "const": "arcane-native-provider-generation" },
        "generationSha256": { "$ref": "#/$defs/sha256" },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "moduleCount": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "protocolVersion", "features", "supportedCapabilities", "supportedMethods", "canonicalLocation", "contentSha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "protocolVersion": { "type": "string", "pattern": "^arcane/[1-9][0-9]*$" },
        "features": { "$ref": "#/$defs/contractList" },
        "supportedCapabilities": { "$ref": "#/$defs/contractList" },
        "supportedMethods": { "$ref": "#/$defs/contractList" },
        "canonicalLocation": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contractList": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalLocation", "policySha256", "contentSha256", "fileCount", "totalBytes"],
      "properties": {
        "canonicalLocation": { "type": "string", "minLength": 1 },
        "policySha256": { "$ref": "#/$defs/sha256" },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "descriptorSha256", "release"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "minLength": 1 },
        "descriptorSha256": { "$ref": "#/$defs/sha256" },
        "release": { "$ref": "#/$defs/release" }
      }
    },
    "targetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "platform", "architecture", "format", "signing"],
      "properties": {
        "target": { "enum": ["portable", "windows-x64", "linux-x64", "linux-arm64", "android-arm64"] },
        "platform": { "enum": ["windows", "linux", "android"] },
        "architecture": { "enum": ["x64", "arm64"] },
        "format": { "enum": ["portable", "exe", "appimage", "deb", "rpm", "apk", "aab"] },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "profileId"],
          "properties": {
            "mode": { "enum": ["unsigned-local-test", "development", "production"] },
            "profileId": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
