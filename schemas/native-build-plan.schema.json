{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheWizardNexus/arcane-os-sdk/schemas/native-build-plan.schema.json",
  "title": "Arcane native build plan",
  "description": "Direct structural inputs for one selected native build.",
  "type": "object",
  "required": [
    "protocol",
    "nativeBuilder",
    "toolchainRoot",
    "toolchain",
    "appDescriptor",
    "application",
    "dependencies",
    "minimumCoreVersion",
    "protectedRoots",
    "outputRoot",
    "targetRequest"
  ],
  "properties": {
    "protocol": { "const": "arcane-native-build-plan/1" },
    "nativeBuilder": { "$ref": "#/$defs/nativeBuilder" },
    "toolchainRoot": { "type": "string", "minLength": 1 },
    "toolchain": { "type": "object" },
    "appDescriptor": { "type": "object" },
    "application": { "$ref": "#/$defs/releaseSelection" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependencySelection" }
    },
    "minimumCoreVersion": {
      "type": ["string", "null"]
    },
    "protectedRoots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "outputRoot": { "type": "string", "minLength": 1 },
    "targetRequest": { "$ref": "#/$defs/targetRequest" }
  },
  "$defs": {
    "nativeBuilder": {
      "type": "object",
      "required": ["protocol", "describe", "doctor", "prepare", "build", "verify", "run"],
      "properties": {
        "protocol": { "const": "arcane-native-builder/1" },
        "describe": {},
        "doctor": {},
        "prepare": {},
        "build": {},
        "verify": {},
        "run": {}
      }
    },
    "release": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "releaseSelection": {
      "type": "object",
      "required": ["root", "release", "readFile"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "release": { "$ref": "#/$defs/release" },
        "readFile": {}
      }
    },
    "dependencySelection": {
      "allOf": [
        { "$ref": "#/$defs/releaseSelection" },
        {
          "type": "object",
          "required": ["appId"],
          "properties": {
            "appId": { "$ref": "#/$defs/appId" }
          }
        }
      ]
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "unsignedTargetRequest": {
      "type": "object",
      "required": ["target", "platform", "architecture", "format", "signing", "signingProfileId"],
      "properties": {
        "signing": { "const": "unsigned-local-test" },
        "signingProfileId": { "type": "null" }
      }
    },
    "targetRequest": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/unsignedTargetRequest" },
            {
              "properties": {
                "target": { "const": "portable" },
                "platform": { "enum": ["windows", "linux"] },
                "architecture": { "enum": ["x64", "arm64"] },
                "format": { "const": "portable" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/unsignedTargetRequest" },
            {
              "properties": {
                "target": { "const": "windows-x64" },
                "platform": { "const": "windows" },
                "architecture": { "const": "x64" },
                "format": { "const": "exe" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/unsignedTargetRequest" },
            {
              "properties": {
                "target": { "const": "linux-x64" },
                "platform": { "const": "linux" },
                "architecture": { "const": "x64" },
                "format": { "const": "deb" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/unsignedTargetRequest" },
            {
              "properties": {
                "target": { "const": "linux-arm64" },
                "platform": { "const": "linux" },
                "architecture": { "const": "arm64" },
                "format": { "const": "deb" }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": ["target", "platform", "architecture", "format", "signing", "signingProfileId"],
          "properties": {
            "target": { "const": "android-arm64" },
            "platform": { "const": "android" },
            "architecture": { "const": "arm64" },
            "format": { "const": "apk" },
            "signing": { "const": "development" },
            "signingProfileId": { "const": "arcane-android-development-v1" }
          }
        }
      ]
    }
  }
}
