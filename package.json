{
  "name": "arcane-os",
  "version": "0.1.0-dev.2",
  "description": "Arcane OS application SDK, CLI, browser runtime, and cross-platform build toolchain.",
  "type": "module",
  "main": "./src/index.mjs",
  "bin": {
    "arcane": "./bin/arcane.mjs",
    "arcane-os": "./bin/arcane.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./toolchain": "./src/toolchain.mjs",
    "./events": "./src/events.mjs",
    "./testing": "./src/testing.mjs",
    "./targets": "./src/targets/index.mjs",
    "./native": "./src/native-plan.mjs",
    "./native-provider": "./src/native-provider-loader.mjs",
    "./integrated-provider": "./src/integrated-provider-loader.mjs",
    "./packager": "./src/packager/core.mjs",
    "./runtime/manifest": "./runtime/ARCANE_RUNTIME_RELEASE.json",
    "./schemas/arcane-app.json": "./schemas/arcane-app.schema.json",
    "./schemas/arcane-package.json": "./schemas/arcane-package.schema.json",
    "./schemas/arcane-lock.json": "./schemas/arcane-lock.schema.json",
    "./schemas/cli-event.json": "./schemas/cli-event.schema.json",
    "./schemas/native-build-plan.json": "./schemas/native-build-plan.schema.json",
    "./schemas/target-adapter.json": "./schemas/target-adapter.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "runtime/",
    "schemas/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:functional && npm run test:integration && npm run test:regression",
    "test:unit": "node ./bin/arcane-test.mjs test/app-descriptor.test.mjs test/app-schema.test.mjs test/contracts.test.mjs test/doctor.test.mjs test/targets.test.mjs",
    "test:functional": "node ./bin/arcane-test.mjs test/cli.test.mjs test/dev-server.test.mjs test/events.test.mjs test/packaging.test.mjs test/runtime.test.mjs test/scaffold.test.mjs test/site.test.mjs",
    "test:integration": "node ./bin/arcane-test.mjs test/integrated-shared.test.mjs test/integrated-workspace.test.mjs test/native-plan.test.mjs test/native-provider-loader.test.mjs test/shared-payload-batch.test.mjs test/tarball.test.mjs",
    "test:regression": "node ./bin/arcane-test.mjs test/channel-workflows.test.mjs test/native-provider-generation.test.mjs test/testing.test.mjs test/test-sets.test.mjs",
    "check": "node tools/check-source.mjs && node tools/runtime-manifest.mjs --verify && npm test",
    "runtime:verify": "node tools/runtime-manifest.mjs --verify",
    "pack:local": "npm pack --ignore-scripts",
    "pack:inspect": "npm pack --dry-run --json",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheWizardNexus/arcane-os-sdk.git"
  },
  "homepage": "https://thewizardnexus.github.io/arcane-os-sdk/",
  "bugs": {
    "url": "https://github.com/TheWizardNexus/arcane-os-sdk/issues"
  },
  "keywords": [
    "arcane-os",
    "sdk",
    "cli",
    "applications",
    "ollama"
  ],
  "author": "The Wizard Nexus",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "dev"
  },
  "dependencies": {
    "vanilla-test": "2.1.3"
  }
}
